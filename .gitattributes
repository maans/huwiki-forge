# ForgeShare bundles are deterministic across macOS, Windows and Linux.
plugins/forgeshare/** text eol=lf
plugins/forgeshare/helper/*.cmd text eol=crlf
plugins/forgeshare/dist/*.zip binary
scripts/build-forgeshare.mjs text eol=lf
tests/forgeshare.test.mjs text eol=lf
plugins/forgeshare/native/compiled/ForgeShare binary
plugins/forgeshare/native/compiled/*.exe binary
plugins/forgeshare/native/compiled/*.icns binary

# Known-good macOS executables and icons are binary, not LF-normalized text.
plugins/forgeshare/native/known-good/ForgeShare binary
plugins/forgeshare/native/known-good/*.icns binary
