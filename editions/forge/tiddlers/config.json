[
  {
    "title": "$:/DefaultTiddlers",
    "text": "[[HUWiki Forge]]"
  },
  {
    "title": "$:/theme",
    "text": "$:/themes/huwiki/modern"
  },
  {
    "title": "$:/SiteTitle",
    "text": "TiddlyWiki Forge"
  },
  {
    "title": "$:/SiteSubtitle",
    "text": "<$list filter=\"[{$:/language}else[$:/languages/en-GB]prefix[$:/languages/da]]\" variable=\"forgeLocale\">Skab din egen wiki med TiddlyWiki</$list><$list filter=\"[{$:/language}else[$:/languages/en-GB]!prefix[$:/languages/da]]\" variable=\"forgeLocale\">Create your own TiddlyWiki</$list>"
  },
  {
    "title": "$:/state/sidebar",
    "text": "no"
  },
  {
    "title": "$:/huwiki/forge/wide-class",
    "tags": "$:/tags/ClassFilters/PageTemplate",
    "text": "[{$:/state/sidebar}match[no]then[forge-wide]]"
  },
  {
    "title": "$:/huwiki/forge/browser-language",
    "tags": "$:/tags/StartupAction/Browser",
    "type": "text/vnd.tiddlywiki",
    "text": "\\define browserPrefix() [{$:/info/browser/language}lowercase[]split[-]first[]!match[]else[en]]\n<$list filter=\"[[$:/language]!is[tiddler]]\" variable=\"unsetLanguage\">\n<$let browserPrefix={{{ [subfilter<browserPrefix>] }}}>\n<$action-setfield $tiddler=\"$:/language\" text={{{ [plugin-type[language]prefix[$:/languages/]sort[title]removeprefix[$:/languages/]prefix<browserPrefix>addprefix[$:/languages/]first[]] ~[[$:/languages/en-GB]] }}}/>\n</$let>\n</$list>"
  }
]
