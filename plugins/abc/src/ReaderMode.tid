title: $:/plugins/huwiki/abc/ReaderMode
type: text/css
tags: $:/tags/Stylesheet

/* Musicians' reading view: the score owns the screen, without altering ABC
   notation, audio or TiddlyWiki's normal editor. Only the active score changes. */
.huwabc-reader-toolbar[hidden],
.huwabc-reader-edges[hidden],
.huwabc-reader-menu-panel[hidden]{display:none!important}
.huwabc-score.huwabc-reader-active{
 position:fixed!important;
 inset:0!important;
 box-sizing:border-box!important;
 width:100vw!important;
 max-width:none!important;
 height:100dvh!important;
 min-height:0!important;
 margin:0!important;
 padding:0!important;
 border:0!important;
 border-radius:0!important;
 display:flex!important;
 flex-direction:column!important;
 overflow:hidden!important;
 z-index:30100!important;
 color:#202521!important;
 background:#ebeeea!important
}
/* The original toolbars and secondary panels remain mounted so audio, mixer
   and the page renderer keep their existing state. They are just not visible. */
.huwabc-reader-active > :not(.huwabc-page-shell):not(.huwabc-audio):not(.huwabc-reader-toolbar):not(.huwabc-reader-edges){
 display:none!important
}
/* PageView rehomes the SVG inside a top-level page-shell. The original
   .huwabc-paper is NOT a top-level child, so keep the actual page-shell. */
.huwabc-reader-active > .huwabc-page-shell{
 display:flex!important;
 flex:1 1 auto!important;
 flex-direction:column!important;
 position:relative!important;
 margin:0!important;
 padding:0!important;
 border:0!important;
 border-radius:0!important;
 min-height:0!important;
 min-width:0!important;
 max-height:none!important;
 max-width:none!important;
 width:100%!important;
 overflow:auto!important;
 overscroll-behavior:contain;
 -webkit-overflow-scrolling:touch;
 background:#ebeeea!important
}
.huwabc-reader-active .huwabc-page-toolbar{display:none!important}
/* The OUTER shell is a full-height stage, not a paper-sized card.
   Keep shadows on the actual page elements instead of capping the stage. */
.huwabc-reader-active > .huwabc-page-shell{
 height:100%!important;
 max-height:100%!important;
 align-items:stretch!important;
 justify-content:flex-start!important;
 box-shadow:none!important;
}
.huwabc-reader-active .huwabc-page-viewport{
 margin:0 auto!important;
 max-width:none!important;
 max-height:none!important;
 flex:0 0 auto!important;
}
.huwabc-reader-active .huwabc-page-shell{
 box-shadow:none!important
}
.huwabc-reader-active .huwabc-page-viewport{
 transform:none!important;
 transform-origin:top center!important;
}
.huwabc-reader-fit-choice{
 min-height:40px;
 max-width:100%;
 border-radius:7px;
 border:1px solid #82958b;
 background:#e5ebe6;
 color:#162923;
 padding:4px
}
.huwabc-reader-active .huwabc-audio{display:none!important}
.huwabc-reader-active.huwabc-reader-practice .huwabc-audio{
 display:block!important;
 position:relative!important;
 order:2;
 box-sizing:border-box!important;
 width:100%!important;
 flex:0 0 auto!important;
 max-height:min(34dvh,290px)!important;
 min-height:0!important;
 overflow:auto!important;
 padding:7px 10px!important;
 border:0!important;
 border-top:1px solid #ccd3cb!important;
 background:#f1f4ef!important
}
/* Prefer a floating, compact menu over permanently stacked page widgets. */
.huwabc-reader-toolbar{
 position:absolute;
 z-index:210;
 top:env(safe-area-inset-top,0px);
 right:env(safe-area-inset-right,0px);
 display:flex;
 align-items:flex-start;
 flex-direction:row-reverse;
 gap:7px;
 padding:9px;
 pointer-events:none
}
.huwabc-reader-toolbar button,
.huwabc-reader-toolbar select,
.huwabc-reader-edges button{font:inherit;touch-action:manipulation}
.huwabc-reader-list{
 pointer-events:auto;
 cursor:pointer;
 border:1px solid #9aa8a0;
 box-shadow:0 1px 8px #0002;
 background:#f8faf7ef;
 color:#172d27;
 border-radius:9px;
 min-height:44px;
 padding:7px 13px;
 font-size:14px!important;
 font-weight:650
}
.huwabc-reader-menu{
 pointer-events:auto;
 cursor:pointer;
 border:1px solid #9aa8a0;
 box-shadow:0 1px 8px #0002;
 background:#f8faf7ef;
 color:#172d27;
 border-radius:9px;
 min-width:44px;
 min-height:44px;
 padding:7px 12px;
 font-size:21px!important;
 line-height:1.1
}
.huwabc-reader-menu-panel{
 pointer-events:auto;
 color:#e9f0eb;
 width:min(360px,calc(100vw - 85px));
 max-height:65dvh;
 overflow:auto;
 padding:13px;
 background:#1a2924f2;
 box-shadow:0 12px 32px #0005;
 border-radius:11px
}
.huwabc-reader-title{
 display:block;
 font-size:14px;
 line-height:1.25;
 margin-bottom:12px;
 max-height:2.5em;
 overflow:hidden
}
.huwabc-reader-modes{display:flex;gap:5px;margin-bottom:10px}
.huwabc-reader-modes .huwabc-reader-mode-button{
 flex:1;
 padding:9px 6px;
 border-radius:8px;
 border:1px solid #889990;
 background:transparent;
 color:inherit
}
.huwabc-reader-modes button[aria-pressed="true"]{
 background:#e2e9e1;
 color:#182b22;
 font-weight:700
}
.huwabc-reader-options{display:flex;flex-wrap:wrap;align-items:end;gap:7px}
.huwabc-reader-options>*{flex:1 1 130px}
.huwabc-reader-options>button{
 padding:9px 6px;
 min-height:40px;
 background:#34483f;
 border:1px solid #82958b;
 border-radius:7px;
 color:inherit
}
.huwabc-reader-options>button[aria-pressed="true"]{
 background:#dae8db;
 color:#1d3629
}
.huwabc-reader-field{display:flex;flex-direction:column;gap:4px;font-size:12px}
.huwabc-reader-page-choice{min-height:40px;max-width:100%;border-radius:7px;border:1px solid #82958b;background:#e5ebe6;color:#162923;padding:4px}
.huwabc-reader-counter{display:block;font-size:12px;opacity:.85;margin-top:7px}
/* Tall edge targets permit a tap on either side of the sheet. The central
   notation is unobstructed, preserving its existing pinch-to-zoom gesture. */
.huwabc-reader-edges{
 position:absolute;
 z-index:190;
 pointer-events:none;
 inset:calc(62px + env(safe-area-inset-top,0px)) 0 0 0;
 display:flex;
 justify-content:space-between;
 align-items:stretch;
 padding:0 6px
}
.huwabc-reader-edges button{
 box-sizing:border-box;
 display:flex;
 flex:0 0 auto;
 align-items:flex-end;
 justify-content:center;
 pointer-events:auto;
 border:0;
 border-radius:0;
 background:transparent;
 color:#2b4135;
 font-size:26px;
 line-height:1;
 width:clamp(44px,6vw,72px);
 min-width:44px;
 height:100%;
 min-height:0;
 padding:0 0 calc(12px + env(safe-area-inset-bottom,0px));
 opacity:.48;
 cursor:pointer
}
.huwabc-reader-edges button:focus-visible,
.huwabc-reader-edges button:hover{
 opacity:1;
 outline:2px solid #386e57;
 background:#f7faf055
}
.huwabc-reader-edges button:disabled{opacity:.18;cursor:default}
.huwabc-reader-active.huwabc-reader-practice .huwabc-reader-edges{
 bottom:calc(min(34dvh,290px) + 8px)
}
@media(max-width:730px){
 .huwabc-reader-menu-panel{width:min(310px,calc(100vw - 72px))}
 .huwabc-reader-toolbar{padding:5px}
 .huwabc-reader-edges{padding:0 3px}
 .huwabc-reader-edges button{min-width:44px;min-height:0}
}

/* The reader and Repertoire share one window. The optional number drawer and
   Music Minus One controls float above the notation, never resize the page. */
.huwrep-book.huwrep-reader-active .huwrep-book-list:not([hidden]){
 position:fixed!important;
 z-index:30200!important;
 top:calc(62px + env(safe-area-inset-top,0px))!important;
 left:9px!important;
 right:auto!important;
 width:min(405px,calc(100vw - 18px))!important;
 max-height:calc(90dvh - 72px)!important;
 overflow:auto!important;
 border-radius:12px!important;
 box-shadow:0 14px 45px #14251c66!important
}
.huwrep-book.huwrep-reader-practice .huwrep-book-practice{
 position:fixed!important;
 z-index:30150!important;
 top:calc(62px + env(safe-area-inset-top,0px))!important;
 right:8px!important;
 left:auto!important;
 width:min(420px,calc(100vw - 18px))!important;
 box-sizing:border-box!important;
 margin:0!important;
 max-height:50dvh!important;
 overflow:auto!important;
 box-shadow:0 12px 32px #14251c55!important;
 border:1px solid #d4dfd3!important;
 border-radius:10px!important;
 background:#f4f8f0!important
}
@media(max-width:700px){
 .huwrep-book.huwrep-reader-practice .huwrep-book-practice{
  top:auto!important;
  bottom:calc(58px + env(safe-area-inset-bottom,0px))!important;
  max-height:43dvh!important
 }
}

/* Page-count choices belong to Nodepult, never the everyday Normal reader.
   Keep editor-only layout controls available for notation editing. */
.huwabc-page-shell:not(.huwabc-page-is-desk):not(.huwabc-page-editor) > .huwabc-page-toolbar > .huwabc-page-choice:first-child{
 display:none!important;
}

/* Compact Nodebog controls: four monochrome actions on ONE row. The dropdowns
   live below them; the panel floats under the two small toolbar icons rather
   than taking the full toolbar width or covering half of the score. */
.huwabc-reader-toolbar{
 gap:5px;
 padding:6px;
 align-items:center;
}
.huwabc-reader-toolbar>.huwabc-reader-list,
.huwabc-reader-toolbar>.huwabc-reader-menu{
 display:inline-flex;
 align-items:center;
 justify-content:center;
 box-sizing:border-box;
 flex:0 0 44px;
 width:44px;
 min-width:44px;
 height:44px;
 min-height:44px;
 padding:0!important;
 border-radius:9px;
 box-shadow:0 1px 5px #0002;
}
.huwabc-reader-icon-button svg{
 display:block;
 flex:none;
 pointer-events:none;
}
.huwabc-reader-menu-panel{
 position:absolute;
 top:calc(100% + 2px);
 right:6px;
 box-sizing:border-box;
 width:min(284px,calc(100vw - 16px));
 max-height:min(68dvh,490px);
 padding:9px;
 border-radius:10px;
}
.huwabc-reader-title{
 font-size:12px;
 line-height:1.25;
 max-height:2.5em;
 margin-bottom:7px;
}
.huwabc-reader-modes{
 display:grid;
 grid-template-columns:repeat(4,minmax(0,1fr));
 gap:5px;
 margin:0 0 8px;
}
.huwabc-reader-modes .huwabc-reader-mode-button{
 display:flex;
 align-items:center;
 justify-content:center;
 box-sizing:border-box;
 min-width:0;
 width:100%;
 min-height:42px;
 height:42px;
 padding:0!important;
 border-radius:8px;
 cursor:pointer;
}
.huwabc-reader-modes .huwabc-reader-mode-button:disabled{
 opacity:.35;
 cursor:default;
}
.huwabc-reader-modes .huwabc-reader-mode-button:hover:not(:disabled){
 background:#455b50;
}
.huwabc-reader-modes .huwabc-reader-mode-button[aria-pressed="true"]:hover{
 background:#e2e9e1;
}
.huwabc-reader-modes .huwabc-reader-mode-button:focus-visible,
.huwabc-reader-toolbar>.huwabc-reader-icon-button:focus-visible{
 outline:2px solid #8ecab0;
 outline-offset:2px;
}
.huwabc-reader-options{
 display:grid;
 grid-template-columns:repeat(2,minmax(0,1fr));
 align-items:end;
 gap:7px;
}
.huwabc-reader-options>*{
 flex:none;
 min-width:0;
 width:100%;
}
.huwabc-reader-field{font-size:11px;gap:3px}
.huwabc-reader-field select{
 box-sizing:border-box;
 display:block;
 width:100%;
 min-width:0;
 min-height:38px;
 font-size:12px;
 padding:5px 6px;
}
.huwabc-reader-counter{margin-top:6px;font-size:11px}
@media(max-width:730px){
 .huwabc-reader-toolbar{padding:5px;gap:4px}
 .huwabc-reader-menu-panel{right:5px;width:min(276px,calc(100vw - 12px))}
}
