\"instant-doc-heading\\\"><$view field=\\\"title\\\"/></h4><<instant-heading-edit-button>></div></$list>\\n<$list filter=\\\"[all[current]field:instant-level[5]]\\\"><div class=\\\"instant-doc-heading-wrap\\\"><h5 class=\\\"instant-doc-heading\\\"><$view field=\\\"title\\\"/></h5><<instant-heading-edit-button>></div></$list>\\n<$list filter=\\\"[all[current]field:instant-level[6]]\\\"><div class=\\\"instant-doc-heading-wrap\\\"><h6 class=\\\"instant-doc-heading\\\"><$view field=\\\"title\\\"/></h6><<instant-heading-edit-button>></div></$list>\\n<div class=\\\"instant-doc-body\\\"><$transclude/></div>\\n\\\\end\\n\\n\\\\define instant-render-part()\\n<$let partTitle=<<currentTiddler>>>\\n<div class=\\\"instant-doc-part\\\">\\n<$reveal state=\\\"$:/temp/instant-wiki/document/edit\\\" type=\\\"nomatch\\\" text=<<partTitle>>>\\n<$button class=\\\"tc-btn-invisible instant-doc-edge instant-doc-edge-left\\\" tooltip=\\\"Redigér denne dokumentdel\\\" aria-label=\\\"Redigér denne dokumentdel fra venstre kant\\\">\\n<<instant-start-edit-actions>><span>✎</span>\\n</$button>\\n<$button class=\\\"tc-btn-invisible instant-doc-edge instant-doc-edge-right\\\" tooltip=\\\"Redigér denne dokumentdel\\\" aria-label=\\\"Redigér denne dokumentdel fra højre kant\\\">\\n<<instant-start-edit-actions>><span>✎</span>\\n</$button>\\n<$list filter=\\\"[all[current]field:toc-type[heading]]\\\" emptyMessage=\\\"\\\"><<instant-render-heading>></$list>\\n<$list filter=\\\"[all[current]!field:toc-type[heading]]\\\" emptyMessage=\\\"\\\"><div class=\\\"instant-doc-body\\\"><$transclude/></div></$list>\\n</$reveal>\\n<$reveal state=\\\"$:/temp/instant-wiki/document/edit\\\" type=\\\"match\\\" text=<<partTitle>>>\\n<div class=\\\"instant-doc-edit-panel\\\">\\n<$keyboard key=\\\"ctrl+enter meta+enter\\\" actions=<<instant-save-edit-actions>> tag=\\\"div\\\">\\n<$keyboard key=\\\"escape\\\" actions=<<instant-cancel-edit-actions>> tag=\\\"div\\\">\\n<$edit-text tiddler=\\\"$:/temp/instant-wiki/document/edittext\\\" field=\\\"text\\\" tag=\\\"textarea\\\" class=\\\"instant-doc-editor\\\"/>\\n</$keyboard>\\n</$keyboard>\\n<div class=\\\"instant-doc-edit-actions\\\">\\n<span class=\\\"instant-doc-shortcuts\\\">⌘/Ctrl+Enter gem · Esc fortryd</span>\\n<$button class=\\\"instant-doc-action instant-doc-save\\\"><<instant-save-edit-actions>>✓ Gem</$button>\\n<$button class=\\\"instant-doc-action\\\"><<instant-cancel-edit-actions>>Fortryd</$button>\\n</div>\\n</div>\\n</$reveal>\\n<$list filter=\\\"[list<currentTiddler>]\\\" variable=\\\"childTitle\\\">\\n<$tiddler tiddler=<<childTitle>>><<instant-render-part>></$tiddler>\\n</$list>\\n</div>\\n</$let>\\n\\\\end\\n\\n<$let documentRoot=<<currentTiddler>>>\\n<div class=\\\"instant-doc-shell\\\">\\n<$list filter=\\\"[<documentRoot>match[Dokument]]\\\">\\n<h1 class=\\\"instant-doc-title\\\"><$transclude tiddler=<<documentRoot>> field=\\\"instant-document-title\\\"/></h1>\\n</$list>\\n<div class=\\\"instant-doc-topbar\\\">\\n<$button class=\\\"instant-doc-open-parts\\\" tooltip=\\\"Åbn alle dokumentdele som almindelige tiddlere i den rigtige rækkefølge\\\">\\n<$action-setfield $tiddler=\\\"$:/StoryList\\\" $field=\\\"list\\\" $value={{{ [<documentRoot>get[instant-flat-list]] }}} $timestamp=\\\"no\\\"/>\\n☷ Åbn som tiddlere\\n</$button>\\n<$list filter=\\\"[<documentRoot>has[instant-source-url]]\\\">\\n<a class=\\\"instant-doc-source-link\\\" href={{{ [<documentRoot>get[instant-source-url]] }}} target=\\\"_blank\\\" rel=\\\"noopener noreferrer\\\">Åbn kildedokument ↗</a>\\n</$list>\\n</div>\\n<p class=\\\"instant-doc-intro\\\"><strong>Sammenhængende dokument.</strong> Delene nedenfor er selvstændige tiddlere. Klik en sektionsoverskrift eller en af sidekanterne for at redigere direkte. Gem med ⌘/Ctrl+Enter eller fortryd med Esc. Du kan også åbne alle delene i Story River med knappen ovenfor.</p>\\n<div class=\\\"instant-doc\\\">\\n<$list filter=\\\"[<documentRoot>get[list]enlist-input[]]\\\" variable=\\\"partTitle\\\">\\n<$tiddler tiddler=<<partTitle>>><<instant-render-part>></$tiddler>\\n</$list>\\n</div>\\n</div>\\n</$let>\"},\"$:/plugins/huwiki/instantwiki/document-view-en\":{\"title\":\"$:/plugins/huwiki/instantwiki/document-view-en\",\"type\":\"text/vnd.tiddlywiki\",\"text\":\"\\\\whitespace trim\\n\\\\define instant-start-edit-actions()\\n<$action-setfield $tiddler=\\\"$:/temp/instant-wiki/document/edittext\\\" text={{!!text}} $timestamp=\\\"no\\\"/>\\n<$action-setfield $tiddler=\\\"$:/temp/instant-wiki/document/edit\\\" text=<<partTitle>> $timestamp=\\\"no\\\"/>\\n\\\\end\\n\\n\\\\define instant-save-edit-actions()\\n<$action-setfield $tiddler=<<partTitle>> $field=\\\"text\\\" $value={{$:/temp/instant-wiki/document/edittext}}/>\\n<$action-setfield $tiddler=\\\"$:/temp/instant-wiki/document/edit\\\" text=\\\"\\\" $timestamp=\\\"no\\\"/>\\n<$action-setfield $tiddler=\\\"$:/temp/instant-wiki/document/edittext\\\" text=\\\"\\\" $timestamp=\\\"no\\\"/>\\n\\\\end\\n\\n\\\\define instant-cancel-edit-actions()\\n<$action-setfield $tiddler=\\\"$:/temp/instant-wiki/document/edit\\\" text=\\\"\\\" $timestamp=\\\"no\\\"/>\\n<$action-setfield $tiddler=\\\"$:/temp/instant-wiki/document/edittext\\\" text=\\\"\\\" $timestamp=\\\"no\\\"/>\\n\\\\end\\n\\n\\\\define instant-heading-edit-button()\\n<$button class=\\\"tc-btn-invisible instant-doc-heading-hit\\\" tooltip=\\\"Click the heading to edit this document part\\\" aria-label=\\\"Edit this document part\\\">\\n<<instant-start-edit-actions>>\\n<span class=\\\"instant-doc-edit-hint\\\">✎ Edit</span>\\n</$button>\\n\\\\end\\n\\n\\\\define instant-render-heading()\\n<$list filter=\\\"[all[current]field:instant-level[1]]\\\"><div class=\\\"instant-doc-heading-wrap\\\"><h1 class=\\\"instant-doc-heading\\\"><$view field=\\\"title\\\"/></h1><<instant-heading-edit-button>></div></$list>\\n<$list filter=\\\"[all[current]field:instant-level[2]]\\\"><div class=\\\"instant-doc-heading-wrap\\\"><h2 class=\\\"instant-doc-heading\\\"><$view field=\\\"title\\\"/></h2><<instant-heading-edit-button>></div></$list>\\n<$list filter=\\\"[all[current]field:instant-level[3]]\\\"><div class=\\\"instant-doc-heading-wrap\\\"><h3 class=\\\"instant-doc-heading\\\"><$view field=\\\"title\\\"/></h3><<instant-heading-edit-button>></div></$list>\\n<$list filter=\\\"[all[current]field:instant-level[4]]\\\"><div class=\\\"instant-doc-heading-wrap\\\"><h4 class=\\\"instant-doc-heading\\\"><$view field=\\\"title\\\"/></h4><<instant-heading-edit-button>></div></$list>\\n<$list filter=\\\"[all[current]field:instant-level[5]]\\\"><div class=\\\"instant-doc-heading-wrap\\\"><h5 class=\\\"instant-doc-heading\\\"><$view field=\\\"title\\\"/></h5><<instant-heading-edit-button>></div></$list>\\n<$list filter=\\\"[all[current]field:instant-level[6]]\\\"><div class=\\\"instant-doc-heading-wrap\\\"><h6 class=\\\"instant-doc-heading\\\"><$view field=\\\"title\\\"/></h6><<instant-heading-edit-button>></div></$list>\\n<div class=\\\"instant-doc-body\\\"><$transclude/></div>\\n\\\\end\\n\\n\\\\define instant-render-part()\\n<$let partTitle=<<currentTiddler>>>\\n<div class=\\\"instant-doc-part\\\">\\n<$reveal state=\\\"$:/temp/instant-wiki/document/edit\\\" type=\\\"nomatch\\\" text=<<partTitle>>>\\n<$button class=\\\"tc-btn-invisible instant-doc-edge instant-doc-edge-left\\\" tooltip=\\\"Edit this document part\\\" aria-label=\\\"Edit this document part from the left edge\\\">\\n<<instant-start-edit-actions>><span>✎</span>\\n</$button>\\n<$button class=\\\"tc-btn-invisible instant-doc-edge instant-doc-edge-right\\\" tooltip=\\\"Edit this document part\\\" aria-label=\\\"Edit this document part from the right edge\\\">\\n<<instant-start-edit-actions>><span>✎</span>\\n</$button>\\n<$list filter=\\\"[all[current]field:toc-type[heading]]\\\" emptyMessage=\\\"\\\"><<instant-render-heading>></$list>\\n<$list filter=\\\"[all[current]!field:toc-type[heading]]\\\" emptyMessage=\\\"\\\"><div class=\\\"instant-doc-body\\\"><$transclude/></div></$list>\\n</$reveal>\\n<$reveal state=\\\"$:/temp/instant-wiki/document/edit\\\" type=\\\"match\\\" text=<<partTitle>>>\\n<div class=\\\"instant-doc-edit-panel\\\">\\n<$keyboard key=\\\"ctrl+enter meta+enter\\\" actions=<<instant-save-edit-actions>> tag=\\\"div\\\">\\n<$keyboard key=\\\"escape\\\" actions=<<instant-cancel-edit-actions>> tag=\\\"div\\\">\\n<$edit-text tiddler=\\\"$:/temp/instant-wiki/document/edittext\\\" field=\\\"text\\\" tag=\\\"textarea\\\" class=\\\"instant-doc-editor\\\"/>\\n</$keyboard>\\n</$keyboard>\\n<div class=\\\"instant-doc-edit-actions\\\">\\n<span class=\\\"instant-doc-shortcuts\\\">⌘/Ctrl+Enter save · Esc cancel</span>\\n<$button class=\\\"instant-doc-action instant-doc-save\\\"><<instant-save-edit-actions>>✓ Save</$button>\\n<$button class=\\\"instant-doc-action\\\"><<instant-cancel-edit-actions>>Cancel</$button>\\n</div>\\n</div>\\n</$reveal>\\n<$list filter=\\\"[list<currentTiddler>]\\\" variable=\\\"childTitle\\\">\\n<$tiddler tiddler=<<childTitle>>><<instant-render-part>></$tiddler>\\n</$list>\\n</div>\\n</$let>\\n\\\\end\\n\\n<$let documentRoot=<<currentTiddler>>>\\n<div class=\\\"instant-doc-shell\\\">\\n<$list filter=\\\"[<documentRoot>match[Dokument]]\\\">\\n<h1 class=\\\"instant-doc-title\\\"><$transclude tiddler=<<documentRoot>> field=\\\"instant-document-title\\\"/></h1>\\n</$list>\\n<div class=\\\"instant-doc-topbar\\\">\\n<$button class=\\\"instant-doc-open-parts\\\" tooltip=\\\"Open all document parts as ordinary tiddlers in their original order\\\">\\n<$action-setfield $tiddler=\\\"$:/StoryList\\\" $field=\\\"list\\\" $value={{{ [<documentRoot>get[instant-flat-list]] }}} $timestamp=\\\"no\\\"/>\\n☷ Open as tiddlers\\n</$button>\\n<$list filter=\\\"[<documentRoot>has[instant-source-url]]\\\">\\n<a class=\\\"instant-doc-source-link\\\" href={{{ [<documentRoot>get[instant-source-url]] }}} target=\\\"_blank\\\" rel=\\\"noopener noreferrer\\\">Open source document ↗</a>\\n</$list>\\n</div>\\n<p class=\\\"instant-doc-intro\\\"><strong>Continuous document.</strong> The parts below are individual tiddlers. Click a section heading or either edge to edit it directly. Save with ⌘/Ctrl+Enter or cancel with Esc. You can also open all parts in the Story River using the button above.</p>\\n<div class=\\\"instant-doc\\\">\\n<$list filter=\\\"[<documentRoot>get[list]enlist-input[]]\\\" variable=\\\"partTitle\\\">\\n<$tiddler tiddler=<<partTitle>>><<instant-render-part>></$tiddler>\\n</$list>\\n</div>\\n</div>\\n</$let>\"},\"$:/Wiki/DocumentView\":{\"title\":\"$:/Wiki/DocumentView\",\"type\":\"text/vnd.tiddlywiki\",\"text\":\"<$list filter=\\\"[{$:/language}prefix[$:/languages/da]]\\\" variable=\\\"instantLanguage\\\">\\n\\n{{||$:/plugins/huwiki/instantwiki/document-view-da}}\\n\\n</$list>\\n<$list filter=\\\"[{$:/language}!prefix[$:/languages/da]]\\\" variable=\\\"instantLanguage\\\">\\n\\n{{||$:/plugins/huwiki/instantwiki/document-view-en}}\\n\\n</$list>\"},\"$:/plugins/huwiki/instantwiki/readme\":{\"title\":\"$:/plugins/huwiki/instantwiki/readme\",\"type\":\"text/vnd.tiddlywiki\",\"text\":\"[[InstantWiki]] · 0.1.0-test.2\\n\\n<$list filter=\\\"[{$:/language}prefix[$:/languages/da]]\\\" variable=\\\"lang\\\">\\n\\nLav en wiki af et lokalt dokument eller et offentligt dokumentlink. Gennemse afsnit og ret titler før import. Fjern et flueben for at samle med foregående afsnit; ingen tekst slettes. Brug TiddlyWikis normale Gem-knap efter import. Ny wiki med valgfri Edition kræver internet; import i din nuværende wiki virker offline.\\n\\nTestudgave. DOCX/ODT: tekst, overskrifter, lister og tabeller. PDF: tekst pr. side eller originalvisning; ingen OCR. Regneark: værdier fra ét valgt ark; ingen formler eller diagrammer. HTML: kun sikkert tekstindhold; billeder er markører. Gamle DOC-filer skal eksporteres først. Dokumentlinks kræver offentlig adgang og CORS.\\n\\n</$list><$list filter=\\\"[{$:/language}!prefix[$:/languages/da]]\\\" variable=\\\"lang\\\">\\n\\nCreate a wiki from a local document or a public document URL. Review sections and edit titles before import. Clear a checkmark to merge with the preceding section; no text is discarded. Use TiddlyWiki’s normal Save button after importing. Creating a new wiki with an optional Edition needs internet; importing here works offline.\\n\\nTest release. DOCX/ODT: text, headings, lists and tables. PDF: text per page or original view; no OCR. Spreadsheets: values from one selected sheet; no formulas or charts. HTML: safe text content; images become placeholders. Export legacy DOC files first. Document URLs need public access and CORS.\\n\\n</$list>\\n\\nOriginal InstantWiki: HUWiki, HUWiki-OAuthLab-backup.zip / Code.js. Original functions and checksum: migration/instantwiki in the repository. No license was declared by this source; no replacement license is inferred.\\n\\nBundled readers (offline): JSZip 3.10.2, Stuart Knightley and contributors (MIT); PDF.js 6.4.299, Mozilla Foundation and contributors (Apache 2.0), the same pinned build as Slideshow; SheetJS CE 0.20.3, SheetJS LLC (Apache 2.0). Full licenses are included under this plugin’s vendor tiddlers.\"}}}"
}
